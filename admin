#!/bin/sh

TEST_DIR=test-cases/
TEST_FILE=test-cases/arguments/operators.ftl
# For coverage: one file through -v and through the plain (non-dogfood) binary, since no fixture
# exercises the Printer, run_file or Silent.
SMOKE_FILE=test-cases/bugs/mixed-banks.ftl
SMOKE_ARGUMENTS="true 1"

export COMPOSE_FILE=docker/compose.yaml

# LESS_CLIPPY (the default in containers) lints only the dogfood build.  The platform-specific code
# is all in it, and the other configurations only add code that's the same everywhere.
clippy_all() {
    cargo clippy --features dogfood || return
    [ -n "$LESS_CLIPPY" ] && return
    cargo clippy \
        && cargo clippy --tests \
        && cargo clippy --features dogfood --tests
}


# Run the smoke file both ways under coverage.  Output (mostly on stderr) is only shown on failure.
smoke_runs() {
    output=$(cargo llvm-cov run --no-report --features dogfood -- -v $SMOKE_FILE $SMOKE_ARGUMENTS 2>&1) \
        && output=$(cargo llvm-cov run --no-report -- $SMOKE_FILE $SMOKE_ARGUMENTS 2>&1) \
        || { echo "$output"; echo "smoke run failed: $SMOKE_FILE $SMOKE_ARGUMENTS"; return 1; }
}


# Run admin again inside the Linux container for an architecture (aarch64 or riscv64).
launch_in_docker() {
    service=alpine-$1
    shift
    # Colour depends on where output goes (stdout), not on whether we can read a terminal (stdin).
    # An explicit CARGO_TERM_COLOR wins: under `watch` stdout is a pipe to tee, but the terminal is
    # still at the end of it.
    if [ -n "$CARGO_TERM_COLOR" ]; then colour=$CARGO_TERM_COLOR
    elif [ -t 1 ]; then colour=always
    else colour=never
    fi
    if [ -t 0 ] && [ -z "$NO_TTY" ]; then
        docker compose run --rm     -e LESS_CLIPPY=${LESS_CLIPPY-1} $service ./admin "$@"
    else
        # TERM too: libtest won't colour without a terminal description, even with --color always.
        docker compose run --rm -T  -e LESS_CLIPPY=${LESS_CLIPPY-1} -e CARGO_TERM_COLOR=$colour -e TERM \
            $service ./admin "$@" < /dev/null
    fi
}


case $1 in

    test)
        export RUST_BACKTRACE=1
        cargo test -- --color "${CARGO_TERM_COLOR:-auto}" \
            && cargo run -q --features dogfood -- -t ${2:-$TEST_DIR} \
            && clippy_all
        ;;

    coverage)
        # Unit tests, fixtures and smoke runs, merged into one report.  `coverage html` opens the
        # browsable report; plain `coverage` lists functions that never ran.
        export RUST_BACKTRACE=1
        cargo llvm-cov clean --workspace \
            && cargo llvm-cov --no-report \
            && cargo llvm-cov run --no-report --features dogfood -- -t $TEST_DIR \
            && smoke_runs \
            || exit
        if [ "$2" = html ]; then
            cargo llvm-cov report --html --open
        else
            # The unit tests are a second binary, so most functions appear twice: keep the ones
            # with no runs in either.  `<_>` entries are uninstantiated generics.  Expect false
            # positives: const fns (run by the compiler), error paths, the other architecture.
            cargo llvm-cov report --json \
                | jq -r '.data[0].functions[] | "\(.count)\t\(.filenames[0])\t\(.name)"' | rustfilt \
                | awk -F'\t' '{ if ($1 > max[$3]) max[$3] = $1; file[$3] = $2 }
                    END { for (f in file) if (max[f] == 0) print file[f] "\t" f }' \
                | grep "$PWD/src/" | sed "s|$PWD/src/||" | grep -v '<_>\|<_, \|<_ as' | sort \
                | awk -F'\t' '{ printf "%-22s %s\n", $1, $2 }'
        fi
        ;;

    verbose)
        F=${2:-$TEST_FILE}; shift; [ $# -gt 0 ] && shift
        RUST_BACKTRACE=1 cargo run -q --features dogfood -- -v $F "$@"
        ;;

    watch)
        shift
        export NO_TTY=1 CARGO_TERM_COLOR=always       # colour survives the pipe to tee
        mkdir -p logs
        log="logs/watch-$(echo "$*" | tr ' /' '__').log"
        watchexec -w src -w test-cases -w Cargo.toml -c -- \
            "{ echo \"# \$(date '+%F %T')  ./admin $*\"; ./admin $*; echo \"# exit \$?\"; } 2>&1 | tee $log"
        ;;

    linux)  shift; launch_in_docker aarch64 "$@" ;;
    riscv)  shift; launch_in_docker riscv64 "$@" ;;

    doc)
        cargo doc --open
        ;;

    count-lines)
        tokei
        ;;

    clean)
        # watchexecs left behind by closing a terminal tab without Ctrl-C: their parent is now
        # launchd (or init), PID 1.  They go first, so they can't start a build mid-clean.
        pids=$(ps -e -o pid= -o ppid= -o args= | awk '$2 == 1 && /watchexec/ {print $1}')
        [ -n "$pids" ] && kill $pids
        cargo clean
        # The containers' build products; their downloaded crates are in separate volumes, and
        # compose recreates these empty.  Docker refuses (and says so) while a container uses one.
        docker volume rm -f footle_alpine-aarch64-target footle_alpine-riscv64-target > /dev/null
        ;;

    upgrade)
        # Toolchains first, then clean out what the old ones built.  `cargo upgrade` (semver-
        # compatible bumps only) goes last: its edit to Cargo.toml is what sets the watchers off,
        # so they build once, with the new toolchains, into empty target directories.
        rustup update \
            && docker compose build --pull --no-cache \
            && "$0" clean \
            && cargo upgrade \
            && git diff --stat Cargo.toml
        ;;

    **)
        F=$1
        shift 1
        cargo run -q -- ${F:-$TEST_FILE} "$@"
    ;;

esac
