#!/bin/sh

TEST_DIR=test-cases/
TEST_FILE=test-cases/arguments/operators.txt

case $1 in

    test)
        RUST_BACKTRACE=1 \
            cargo test \
            && cargo run --features dogfood -- -t ${2:-$TEST_DIR} \
            && cargo clippy \
            && cargo clippy --features dogfood \
            && cargo clippy --tests \
            && cargo clippy --features dogfood --tests
        ;;

    watch)
        case $2 in

            test)
                RUST_BACKTRACE=1 watchexec -w src -w ${3:-$TEST_DIR} -w Cargo.toml -c -- "\
                    cargo test \
                    && cargo run -q --features dogfood -- --test ${3:-$TEST_DIR} \
                    && cargo clippy \
                    && cargo clippy --features dogfood \
                    && cargo clippy --tests \
                    && cargo clippy --features dogfood --tests \
                    "
                ;;

            verbose)
                RUST_BACKTRACE=1 watchexec -w src -w ${3:-$TEST_FILE} -w Cargo.toml -c -- cargo run -q --features dogfood -- -v ${3:-$TEST_FILE}
                ;;

            **)
                F=$2
                shift 2
                RUST_BACKTRACE=1 watchexec -w src -w ${F:-$TEST_FILE} -w Cargo.toml -c -- cargo run -q -- ${F:-$TEST_FILE} $@
                ;;

        esac
        ;;


    doc)
        cargo doc --open
        ;;

    count-lines)
        tokei
        ;;

    **)
        cargo run -q -- ${1:-$TEST_FILE}
    ;;

esac
